# =============================================================================
# Thred — environment template
# Copy to `.env` at the repo root:  cp .env.example .env
# Never commit `.env`. BYOK provider keys for workspaces live in the dashboard.
# =============================================================================

# --- Database & memory store (required) ----------------------------------------
DATABASE_URL=postgresql://user:password@localhost:5432/thred
HYDRA_DB_API_KEY=

# --- Auth & app URLs (required) ----------------------------------------------
# Local dev defaults below. In production, use https://thred.fun and https://api.thred.fun.
BETTER_AUTH_SECRET=replace-with-a-random-32-character-secret
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3000
FRONTEND_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8080
PORT=8080

# --- Google sign-in (optional) -----------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Model providers (CLI evals, MCP extraction; UI uses dashboard BYOK) -----
# Default provider when a role-specific override is unset.
# Supported: openai | groq | xai | openrouter | gemini | ollama | custom
MODEL_PROVIDER=openai

# Override provider per role (optional; falls back to MODEL_PROVIDER).
MEMORY_EXTRACTION_PROVIDER=openai
EVAL_MODEL_PROVIDER=openai

# Provider API keys — set the key(s) matching your provider(s).
OPENAI_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
XAI_API_KEY=
OPENROUTER_API_KEY=

# Generic fallback when a provider-specific key env is unset.
MODEL_API_KEY=
MODEL_BASE_URL=

# Model IDs (optional; provider defaults apply when unset).
MEMORY_EXTRACTION_MODEL=gpt-4o-mini
EVAL_ANSWER_MODEL=gpt-4o-mini
EVAL_JUDGE_MODEL=gpt-4o-mini

# --- MCP (required for apps/mcp) ---------------------------------------------
# Create in dashboard → MCP connection. Never commit a real key to git.
THRED_API_KEY=
# Optional override. Defaults to https://api.thred.fun for the published @thred_nick_01/thred-mcp CLI.
THRED_API_URL=https://api.thred.fun
