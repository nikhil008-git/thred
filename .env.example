# Core services
DATABASE_URL=postgresql://user:password@localhost:5432/thred
HYDRA_DB_API_KEY=

# Auth (use a random value of at least 32 characters in production)
BETTER_AUTH_SECRET=replace-with-a-random-32-character-secret
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3000
FRONTEND_ORIGIN=http://localhost:3000

# Local service ports/URLs
NEXT_PUBLIC_API_URL=http://localhost:8080
PORT=8080

# Optional Google sign-in
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# CLI evaluation/model fallback (the workspace UI uses Configure → BYOK providers)
# MODEL_PROVIDER: openai | groq | xai | openrouter | ollama | custom
MODEL_PROVIDER=openai
MODEL_API_KEY=
MODEL_BASE_URL=
OPENAI_API_KEY=
GROQ_API_KEY=
XAI_API_KEY=
OPENROUTER_API_KEY=
MEMORY_EXTRACTION_MODEL=gpt-5-mini
EVAL_ANSWER_MODEL=gpt-5-mini

# Workspace-scoped Thred agent key created in the dashboard. Required by apps/mcp.
THRED_API_KEY=

# BYOK provider credentials are entered per workspace in the dashboard and are
# encrypted at rest; do not put provider keys in NEXT_PUBLIC_* variables.
