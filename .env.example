# =============================================================================
# Thred — environment template
# Copy to `.env` at the repo root:  cp .env.example .env
# Never commit `.env`. BYOK provider keys for workspaces live in the dashboard.
# =============================================================================

# --- Core services (required for the web app / API) ----------------------------
DATABASE_URL=postgresql://user:password@localhost:5432/thred
HYDRA_DB_API_KEY=

# --- Auth & app URLs (required) ----------------------------------------------
# Local dev defaults below. In production, use https://thred.fun and https://api.thred.fun.
BETTER_AUTH_SECRET=replace-with-a-random-32-character-secret
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3000
FRONTEND_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8080
PORT=8080
NODE_ENV=development

# --- Google sign-in (optional) -----------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Model providers (CLI evals and server-side extraction) -------------------
# Workspace users configure their own BYOK provider credentials in the dashboard.
# Default provider when a role-specific override is unset.
# Supported: openai | groq | xai | openrouter | gemini | ollama | custom
MODEL_PROVIDER=openai

# Override provider per role (optional; falls back to MODEL_PROVIDER).
MEMORY_EXTRACTION_PROVIDER=
EVAL_MODEL_PROVIDER=

# Provider API keys — set the key(s) matching your provider(s).
OPENAI_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
XAI_API_KEY=
OPENROUTER_API_KEY=

# Generic fallback when a provider-specific key env is unset.
MODEL_API_KEY=
MODEL_BASE_URL=

# Recommended low-cost model IDs for local evaluation (optional).
MEMORY_EXTRACTION_MODEL=gpt-4o-mini
EVAL_ANSWER_MODEL=gpt-4o-mini
EVAL_JUDGE_MODEL=gpt-4o-mini

# --- MCP client (only required when running apps/mcp) --------------------------
# Create THRED_API_KEY in the dashboard → MCP connection. Never commit a real key.
THRED_API_KEY=
# Local development URL. Omit/replace with https://api.thred.fun for the published MCP CLI.
THRED_API_URL=http://localhost:8080
